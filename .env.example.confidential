# vLLM Confidential Computing Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# AWS KMS Configuration
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS KMS Key ID (ARN format)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/abc-123-def-456

# ============================================================
# Azure Key Vault Configuration
# ============================================================
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret
# Azure Key Vault Key Name
# AZURE_KEY_NAME=your-key-name

# ============================================================
# GCP KMS Configuration
# ============================================================
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=global
# Path to service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GCP KMS Key ID (keyRing/cryptoKey format)
# GCP_KMS_KEY_ID=my-key-ring/my-crypto-key

# ============================================================
# HashiCorp Vault Configuration
# ============================================================
VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=your_vault_token
# Vault Transit Engine Mount Point
# VAULT_TRANSIT_MOUNT=transit
# Vault Key Name
# VAULT_KEY_NAME=my-transit-key

# ============================================================
# Local KMS Configuration (Development Only)
# ============================================================
# WARNING: Local KMS is NOT secure for production!
# Master key for local encryption (hex format, 64 characters for 32 bytes)
# LOCAL_KMS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================
# NVIDIA Confidential Computing Configuration
# ============================================================
# Force enable/disable NVIDIA CC mode detection
# NVIDIA_CC_MODE=enabled

# ============================================================
# Model Configuration
# ============================================================
# Path to encrypted model weights
# ENCRYPTED_MODEL_PATH=/path/to/encrypted/model
# KMS Key ID for model decryption
# MODEL_ENCRYPTION_KEY_ID=your-kms-key-id
# KMS Provider (aws_kms, azure_key_vault, gcp_kms, hashicorp_vault, local)
# KMS_PROVIDER=aws_kms

# ============================================================
# Server Configuration
# ============================================================
# Require client attestation for inference requests
# REQUIRE_ATTESTATION=true
# Expected measurement hash for attestation verification
# EXPECTED_MEASUREMENT=sha256_hash_here

# ============================================================
# Logging & Debugging
# ============================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
# Enable confidential computing debug mode
# CC_DEBUG=false
