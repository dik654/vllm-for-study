# Application
APP_NAME=distributed-llm-platform
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/distributed_llm
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Router Configuration
ROUTER_STRATEGY=least_latency  # round_robin, least_latency, least_loaded, cost_optimized
HEALTH_CHECK_INTERVAL_SEC=30
PROVIDER_TIMEOUT_SEC=300
RETRY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_ENABLED=true
FREE_TIER_RATE_LIMIT=60  # requests per minute
STARTER_TIER_RATE_LIMIT=300
PRO_TIER_RATE_LIMIT=1000

# Billing
LLM_API_COMMISSION=0.05  # 5%
MEMORY_STORAGE_MARGIN=0.20  # 20%

# Workflow Execution
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WORKFLOW_DEFAULT_TIMEOUT=300
WORKFLOW_MAX_RETRIES=3

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Provider Settings (for provider agent)
PROVIDER_ID=provider_001
PROVIDER_NAME=My LLM Provider
PROVIDER_TOKEN=prov_tok_xxxxx
ROUTER_URL=http://localhost:8000

# vLLM Settings (for provider agent)
VLLM_HOST=localhost
VLLM_PORT=8001
VLLM_MODEL=meta-llama/Llama-3-70b

# Resource Settings (for provider agent)
CONTEXT_MEMORY_CAPACITY_GB=50
CONTEXT_STORAGE_CAPACITY_TB=5
GP_MEMORY_CAPACITY_GB=200
GP_STORAGE_CAPACITY_TB=20

# Pricing (for provider agent) - per unit
TOKEN_INPUT_RATE=0.000001  # $1 per 1M tokens
TOKEN_OUTPUT_RATE=0.000008  # $8 per 1M tokens
REQUEST_BASE_RATE=0.01
CONTEXT_MEMORY_HOURLY_RATE=0.03
CONTEXT_STORAGE_HOURLY_RATE=0.012
GP_MEMORY_HOURLY_RATE=0.009
GP_STORAGE_HOT_HOURLY_RATE=0.001
GP_STORAGE_COLD_HOURLY_RATE=0.0002

# Metrics Reporting
METRIC_REPORT_INTERVAL_SEC=60
HEARTBEAT_INTERVAL_SEC=10
