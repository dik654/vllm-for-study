# Build stage
FROM rust:1.75 as builder

WORKDIR /app

# Install dependencies for SQLx compile-time verification
RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml ./
COPY router/Cargo.toml ./router/
COPY provider/Cargo.toml ./provider/
COPY shared/Cargo.toml ./shared/

# Create dummy source files to cache dependencies
RUN mkdir -p router/src provider/src shared/src && \
    echo "fn main() {}" > router/src/main.rs && \
    echo "fn main() {}" > provider/src/main.rs && \
    echo "pub fn dummy() {}" > shared/src/lib.rs

# Build dependencies only
RUN cargo build --release --bin router

# Remove dummy sources
RUN rm -rf router/src provider/src shared/src

# Copy actual source code
COPY router/src ./router/src
COPY provider/src ./provider/src
COPY shared/src ./shared/src

# Build the actual binary
RUN cargo build --release --bin router

# Runtime stage
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /app/target/release/router /app/router

# Copy migrations
COPY migrations ./migrations

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["./router"]
